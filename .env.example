SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, only for applying migrations with psql (Connect > Session pooler URI). Never used by the app.
SUPABASE_DB_URL=
# Browser client (same values as SUPABASE_URL / SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
DEMO_KEY=
DEMO_USER_ID=
AI_TIMEOUT_MS=30000
# Concept-image generation timeout (image models are slower than text; keep under the route's 60 s limit).
RENDER_TIMEOUT_MS=50000

# Presenter sign-in: /demo?key=$DEMO_KEY. DEMO_USER_ID is printed by `npm run seed:demo`
# (the demo user needs an email so the server can mint a sign-in link; seed-demo uses demo@revivo.local).
# Optional: when set, /api/cron/keepalive requires "Authorization: Bearer $CRON_SECRET" (Vercel sends it).
CRON_SECRET=
# Day before the demo: sign in via /demo?key=..., upload each stage photo once in /scan, then run `npm run prescan`.
